---
import ArticlePage from '../../views/ArticlePage.astro';
import { articles, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  return (await articles('pt')).map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
---
<ArticlePage lang="pt" article={article} />
