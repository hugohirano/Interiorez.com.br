---
import { Image } from 'astro:assets';
import { photo } from '../lib/images';

interface Props { k: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { k, alt, sizes = '100vw', eager = false, class: className } = Astro.props;
const image = photo(k);
const widths = [640, 960, 1280, Math.min(image.width, 1920)].filter((w, i, a) => w <= image.width && a.indexOf(w) === i);
---
<Image src={image} alt={alt} widths={widths} sizes={sizes} class={className} loading={eager ? 'eager' : 'lazy'} decoding="async" />
